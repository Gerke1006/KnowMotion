  ],
  "learning_objectives": [
    "识别合力与加速度的关系",
    "理解质量对加速度的影响",
    "知道经典模型的适用条件"
  ],
  "knowledge": [
    "在惯性系、质量不变的经典力学条件下，F_net=ma。",
    "质量不变时，加速度与合力成正比。",
    "合力一定时，加速度与质量成反比。"
  ],
  "sources": [
    {
      "title": "OpenStax University Physics: Newton's Second Law",
      "url": "https://openstax.org/books/university-physics-volume-1/pages/5-3-newtons-second-law"
    }
  ],
  "scenes": [
    {
      "title": "力改变运动状态",
      "learning_goal": "从速度变化引出加速度",
      "narration": "推小车时，我们关心的是速度怎样变化。描述速度变化快慢的物理量，叫作加速度。",
      "visual_concept": "从速度变化引出加速度",
      "components": [
        {
          "id": "general.process",
          "parameters": {
