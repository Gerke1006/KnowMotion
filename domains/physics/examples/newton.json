    {
      "title": "质量也决定变化",
      "learning_goal": "固定合力比较质量",
      "narration": "同样的合力作用下，质量越大，加速度越小。因此不能只比较推力，而忽略物体质量。",
      "visual_concept": "固定合力比较质量",
      "components": [
        {
          "id": "math.formula",
          "parameters": {
            "title": "质量也决定变化",
            "latex": "a=\\frac{F_{\\mathrm{net}}}{m}",
            "labels": [
              "合力 F_net：N",
              "质量 m：kg",
              "加速度 a：m/s²"
            ]
          }
        }
