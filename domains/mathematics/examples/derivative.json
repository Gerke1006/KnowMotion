      "renderer": "manim"
    },
    {
      "title": "导数：瞬时变化率",
      "learning_goal": "连接数值极限与导数定义",
      "narration": "在横坐标一处，平方函数的导数是二。导数就是差商的极限，前提是这个极限存在。",
      "visual_concept": "连接数值极限与导数定义",
      "components": [
        {
          "id": "math.formula",
          "parameters": {
            "title": "导数：瞬时变化率",
            "latex": "f'(1)=\\lim_{h\\to 0}(2+h)=2",
            "labels": [
              "平均变化率",
              "取极限",
              "瞬时变化率"
            ]
          }
        }
      ],
      "duration": 15,
      "animation_sequence": [],
      "camera": {},
      "audio": {},
      "extensions": {
        "formula": "f'(1)=2",
        "proof_steps": [
          "((1+h)^2-1)/h=2+h, h≠0",
          "lim(h→0)(2+h)=2"
        ]
      },
      "scene_id": "scene_04",
      "domain": "mathematics",
      "renderer": "manim"
    }
  ],
