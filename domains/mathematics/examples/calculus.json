    },
    {
      "title": "积分：把小块累加",
      "learning_goal": "用小矩形表示连续累积",
      "narration": "再看曲线下的面积。把小矩形逐一相加，并让每块越来越窄，得到积分的直观含义。",
      "visual_concept": "用小矩形表示连续累积",
      "components": [
        {
          "id": "math.integral_riemann",
          "parameters": {
            "title": "积分：把小块累加",
