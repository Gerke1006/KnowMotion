      "scene_id": "scene_03",
      "domain": "mathematics",
      "renderer": "manim"
    },
    {
      "title": "两种操作怎样联系？",
      "learning_goal": "连接累积量与其瞬时变化",
      "narration": "把零到某一点的面积记作一个新函数。对连续函数，这个累积函数的导数等于原函数。",
      "visual_concept": "连接累积量与其瞬时变化",
      "components": [
        {
          "id": "math.formula",
          "parameters": {
            "title": "两种操作怎样联系？",
            "latex": "F(x)=\\int_0^x f(t)\\,\\mathrm{d}t\\qquad F'(x)=f(x)",
            "labels": [
              "条件：f 连续",
              "微积分基本定理"
            ]
          }
        }
      ],
      "duration": 15,
      "animation_sequence": [],
      "camera": {},
      "audio": {},
      "extensions": {},
      "scene_id": "scene_04",
      "domain": "mathematics",
      "renderer": "manim"
    },
    {
      "title": "一个具体例子",
      "learning_goal": "用平方函数检查变化与累积",
      "narration": "平方函数累积成三分之立方；再求导，又回到平方。变化和累积，因此被同一个定理联系起来。",
      "visual_concept": "用平方函数检查变化与累积",
      "components": [
        {
          "id": "math.formula",
          "parameters": {
            "title": "一个具体例子",
            "latex": "\\int_0^x t^2\\,\\mathrm{d}t=\\frac{x^3}{3}\\qquad \\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^3}{3}\\right)=x^2",
            "labels": [
              "积分：累积",
              "导数：变化"
            ]
          }
        }
      ],
      "duration": 15,
      "animation_sequence": [],
      "camera": {},
      "audio": {},
      "extensions": {
        "formula": "diff(x**3/3,x)=x**2",
        "proof_steps": [
          "F(x)=Integral(t**2,(t,0,x))=x**3/3",
          "diff(F(x),x)=x**2"
        ]
      },
      "scene_id": "scene_05",
      "domain": "mathematics",
      "renderer": "manim"
    }
  ],
