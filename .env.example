# Keep credentials local. Environment variables override this file.
MODEL_BASE_URL=https://api.minimax.cn/v1
MODEL_NAME=
MODEL_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=Chinese (Mandarin)_Gentle_Youth
MINIMAX_VOICE_NAME=温润青年
TTS_ENABLED=true
NARRATION_LUFS=-16
# Apply speed once to video + voice, preserving pitch. BGM stays at its original tempo.
TTS_SPEED=1
PLAYBACK_SPEED=1.15
TRANSITION_DURATION=0.30
NARRATION_GAP=0.08
# Windows example: D:/audio/vibe-bgm.m4a. Missing configured BGM is a technical error.
BGM_PATH=
BGM_VOLUME=0.30
OUTPUT_DIR=outputs
DATABASE_URL=sqlite:///data/jobs.db
EXECUTION_BACKEND=local
LOCAL_WORKERS=2
RENDER_CONCURRENCY=2
RENDERER_FALLBACK=false
FONT_PATH=C:/Windows/Fonts/simsun.ttc
MANIM_FONT=SimSun
FFMPEG_PATH=
FFPROBE_PATH=
LATEX_COMPILER_PATH=
LATEX_CACHE_DIR=data/latex-cache
API_TOKEN=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vibe-video
CHINESE_FONT=SimSun
ENGLISH_FONT=Times New Roman
SUBTITLE_FONT=Microsoft YaHei
SUBTITLE_FONT_WEIGHT=BOLD
SUBTITLE_COLOR="#FFFFFF"
SUBTITLE_OUTLINE_COLOR="#161044"
SUBTITLE_OUTLINE_WIDTH=5
ENGLISH_FONT_PATH=C:/Windows/Fonts/times.ttf
SUBTITLE_FONT_PATH=C:/Windows/Fonts/msyhbd.ttc
